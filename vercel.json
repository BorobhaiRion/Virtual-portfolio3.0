{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/index", "destination": "/", "permanent": true },
    { "source": "/home", "destination": "/", "permanent": true },
    { "source": "/about", "destination": "/about.html", "permanent": true },
    { "source": "/works", "destination": "/works.html", "permanent": true },
    { "source": "/linefollower", "destination": "/linefollower.html", "permanent": true },
    { "source": "/loading", "destination": "/loading.html", "permanent": true }
  ]
}
