{
  "name": "virtual-portfolio3.0",
  "version": "1.0.0",
  "description": "This is where i experiment on making my own portfolio website.",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i public/css/input.css -o public/css/site.css --minify",
    "build:html": "node scripts/build-views.js",
    "build": "npm run build:css && npm run build:html",
    "start": "npm run build",
    "dev": "npm run build",
    "serve": "node scripts/serve.js",
    "serve:dev": "node server.js",
    "verify": "node scripts/verify.js",
    "verify:render": "node scripts/render-audit.js",
    "verify:all": "node scripts/verify.js && node scripts/render-audit.js",
    "test": "node scripts/verify.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BorobhaiRion/Virtual-portfolio3.0.git"
  },
  "keywords": [],
