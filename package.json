  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/BorobhaiRion/Virtual-portfolio3.0/issues"
  },
  "homepage": "https://github.com/BorobhaiRion/Virtual-portfolio3.0#readme",
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.1.11"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "ejs": "^3.1.10",
    "express": "^5.1.0"
  }
}
